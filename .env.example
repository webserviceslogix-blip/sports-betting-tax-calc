# Google AdSense — get your publisher ID from https://adsense.google.com
# Format: ca-pub-XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_PUB_ID=

# ConvertKit — get these from https://app.kit.com
# Form ID: the numeric ID from your form's embed code
# API Key: found in Settings > Advanced > API Key
NEXT_PUBLIC_CONVERTKIT_FORM_ID=
NEXT_PUBLIC_CONVERTKIT_API_KEY=
