# Google AdSense — get your publisher ID from https://adsense.google.com
# Format: ca-pub-XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_PUB_ID=

# Buttondown — get your API key from https://buttondown.com/settings/programming
# This is a SERVER-SIDE variable (not NEXT_PUBLIC) so the key stays secret
BUTTONDOWN_API_KEY=
